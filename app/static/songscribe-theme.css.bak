/**
 * Songscribe-aligned HSL tokens.
 * Groovebox shell maps these to --bg / --text / etc. in groovebox-ui.css.
 *
 * Supports both dark (default) and light themes via .dark / .light classes.
 * Smooth transitions are applied in groovebox-ui.css.
 */

/* ─── Dark theme (default) ─────────────────────────────────────── */
:root,
:root.dark {
  --background: 12 6% 15%;
  --foreground: 60 5% 96%;
  --card: 12 7% 15%;
  --card-foreground: 24 5% 64%;
  --popover: 34 11% 12%;
  --popover-foreground: 60 5% 96%;
  --primary: 60 5% 96%;
  --primary-foreground: 0 0% 9%;
  --secondary: 10 6% 20%;
  --secondary-foreground: 0 0% 100%;
  --muted: 10 6% 20%;
  --muted-foreground: 33 5% 33%;
  --accent: 10 6% 20%;
  --accent-foreground: 60 5% 96%;
  --destructive: 1 51% 36%;
  --destructive-foreground: 60 5% 96%;
  --border: 30 6% 25%;
  --input: 12 7% 15%;
  --ring: 0 0% 83.1%;
  --font-lexend: "Lexend", system-ui, sans-serif;
  --font-nunito: "Nunito", system-ui, sans-serif;
}

/* ─── Light theme ──────────────────────────────────────────────── */
:root.light {
  --background: 0 0% 100%;
  --foreground: 240 10% 3.9%;
  --card: 0 0% 100%;
  --card-foreground: 240 10% 3.9%;
  --popover: 0 0% 100%;
  --popover-foreground: 240 10% 3.9%;
  --primary: 240 5.9% 10%;
  --primary-foreground: 0 0% 98%;
  --secondary: 240 4.8% 95.9%;
  --secondary-foreground: 240 5.9% 10%;
  --muted: 240 4.8% 95.9%;
  --muted-foreground: 240 3.8% 46.1%;
  --accent: 240 4.8% 95.9%;
  --accent-foreground: 240 5.9% 10%;
  --destructive: 0 84.2% 60.2%;
  --destructive-foreground: 0 0% 98%;
  --border: 240 5.9% 90%;
  --input: 240 5.9% 90%;
  --ring: 240 5.9% 10%;
}

/* ─── Font style classes ───────────────────────────────────────── */
.font-sans,
.font-sans body {
  --font-nunito: "Nunito", system-ui, sans-serif;
  --font-lexend: "Lexend", system-ui, sans-serif;
}

.font-serif,
.font-serif body {
  --font-nunito: "Georgia", "Times New Roman", serif;
  --font-lexend: "Georgia", "Times New Roman", serif;
}

.font-mono,
.font-mono body {
  --font-nunito: ui-monospace, "SFMono-Regular", "Menlo", "Consolas", monospace;
  --font-lexend: ui-monospace, "SFMono-Regular", "Menlo", "Consolas", monospace;
}

/* ─── Palette classes ──────────────────────────────────────────── */
/* Light variants (applied when .light is also on :root) */
:root.light.palette-paper,
:root.palette-paper:not(.dark) {
  --background: 40 30% 96%;
  --foreground: 30 15% 20%;
  --card: 40 25% 94%;
  --border: 30 12% 82%;
  --input: 40 20% 92%;
  --muted: 30 10% 60%;
  --muted-foreground: 30 8% 50%;
}
:root.dark.palette-paper {
  --background: 30 15% 10%;
  --foreground: 35 20% 88%;
  --card: 30 12% 13%;
  --border: 30 8% 22%;
  --input: 30 10% 14%;
  --muted: 30 6% 25%;
  --muted-foreground: 30 5% 45%;
}

:root.light.palette-parchment,
:root.palette-parchment:not(.dark) {
  --background: 40 50% 90%;
  --foreground: 30 20% 22%;
  --card: 40 45% 88%;
  --border: 35 18% 78%;
  --input: 40 40% 86%;
  --muted: 30 12% 58%;
  --muted-foreground: 30 10% 48%;
}
:root.dark.palette-parchment {
  --background: 30 20% 10%;
  --foreground: 25 30% 82%;
  --card: 30 18% 13%;
  --border: 25 12% 22%;
  --input: 30 15% 14%;
  --muted: 25 8% 25%;
  --muted-foreground: 25 6% 45%;
}

:root.light.palette-modern,
:root.palette-modern:not(.dark) {
  --background: 0 0% 100%;
  --foreground: 220 15% 16%;
  --card: 0 0% 98%;
  --border: 220 10% 88%;
  --input: 0 0% 96%;
  --muted: 220 8% 60%;
  --muted-foreground: 220 6% 50%;
}
:root.dark.palette-modern {
  --background: 225 20% 8%;
  --foreground: 215 20% 90%;
  --card: 225 18% 11%;
  --border: 220 12% 22%;
  --input: 225 15% 12%;
  --muted: 220 8% 28%;
  --muted-foreground: 220 6% 48%;
}

:root.light.palette-forest,
:root.palette-forest:not(.dark) {
  --background: 120 25% 96%;
  --foreground: 150 25% 18%;
  --card: 120 20% 94%;
  --border: 130 12% 82%;
  --input: 120 18% 92%;
  --muted: 140 10% 58%;
  --muted-foreground: 140 8% 48%;
}
:root.dark.palette-forest {
  --background: 140 25% 6%;
  --foreground: 145 30% 82%;
  --card: 140 22% 9%;
  --border: 140 12% 20%;
  --input: 140 18% 10%;
  --muted: 145 8% 25%;
  --muted-foreground: 145 6% 45%;
}

:root.light.palette-sunset,
:root.palette-sunset:not(.dark) {
  --background: 20 50% 96%;
  --foreground: 15 40% 20%;
  --card: 20 45% 94%;
  --border: 18 20% 82%;
  --input: 20 40% 92%;
  --muted: 15 15% 58%;
  --muted-foreground: 15 12% 48%;
}
:root.dark.palette-sunset {
  --background: 15 25% 8%;
  --foreground: 25 50% 82%;
  --card: 15 22% 11%;
  --border: 18 15% 22%;
  --input: 15 20% 12%;
  --muted: 20 10% 28%;
  --muted-foreground: 20 8% 48%;
}

:root.light.palette-notion,
:root.palette-notion:not(.dark) {
  --background: 0 0% 100%;
  --foreground: 0 0% 20%;
  --card: 0 0% 98%;
  --border: 0 0% 88%;
  --input: 0 0% 96%;
  --muted: 0 0% 60%;
  --muted-foreground: 0 0% 50%;
}
:root.dark.palette-notion {
  --background: 0 0% 7%;
  --foreground: 280 50% 85%;
  --card: 0 0% 10%;
  --border: 0 0% 20%;
  --input: 0 0% 11%;
  --muted: 0 0% 25%;
  --muted-foreground: 0 0% 45%;
}

:root.light.palette-dark,
:root.palette-dark:not(.dark) {
  --background: 0 0% 100%;
  --foreground: 280 50% 20%;
  --card: 0 0% 98%;
  --border: 0 0% 88%;
  --input: 0 0% 96%;
  --muted: 0 0% 60%;
  --muted-foreground: 0 0% 50%;
}
:root.dark.palette-dark {
  --background: 0 0% 7%;
  --foreground: 280 50% 85%;
  --card: 0 0% 10%;
  --border: 0 0% 20%;
  --input: 0 0% 11%;
  --muted: 0 0% 25%;
  --muted-foreground: 0 0% 45%;
}
